APP_NAME="ShopMini API"
DATABASE_URL=postgresql+psycopg://shopmini:your_password@localhost:5433/shopmini
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]

# สร้างค่าใหม่ด้วยคำสั่ง: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO

ENVIRONMENT=development
DOCS_ENABLED=true